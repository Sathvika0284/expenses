{
  "name": "household-expenses-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack household expense tracker with Express backend, React 19.3 frontend, and Aiven MySQL integration",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace=client && npm run prisma:generate --workspace=server",
    "start": "npm run start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:deploy": "npm run prisma:deploy --workspace=server",
    "prisma:push": "npm run prisma:push --workspace=server"
  },
  "dependencies": {
    "prisma": "^6.19.0",
    "vite": "^6.2.0"
  },
  "keywords": [
    "household",
    "expenses",
    "monorepo",
    "express",
    "react-19",
    "prisma",
    "mysql"
  ],
  "author": "",
  "license": "ISC"
}
