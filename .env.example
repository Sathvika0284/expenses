# Hosted MySQL database URL (e.g. Aiven Cloud, PlanetScale, AWS RDS)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED"

# JWT secret key for signing session tokens (must be at least 32 characters)
JWT_SECRET="replace-with-a-random-secret-key-at-least-32-chars-long"

# Port number for the Express server
PORT=3000

# Client origin for CORS and security checks
# In development: http://localhost:3000
# In production on Render: https://your-app-name.onrender.com
APP_ORIGIN="http://localhost:3000"

# Node environment: 'development' or 'production'
NODE_ENV=development

# Set to 1 if behind a reverse proxy (e.g., Render, Nginx, Cloudflare)
TRUST_PROXY=1
